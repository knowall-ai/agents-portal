# Agents Portal Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# NextAuth Configuration
# =============================================================================
NEXTAUTH_URL=http://localhost:3103
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32

# =============================================================================
# Microsoft Entra ID (Azure AD) Configuration
# =============================================================================
# Multi-tenant app registration ("Agents Portal"). See docs/DEPLOYMENT.adoc.
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
# Default tenant used to sign in. "common" lets any Entra tenant sign in;
# users can switch tenant from the header once signed in.
# Tenants allowed to sign in (comma-separated). Unset = only AZURE_AD_TENANT_ID; with
# AZURE_AD_TENANT_ID=common and this unset, ANY Microsoft account can sign in.
AZURE_AD_ALLOWED_TENANTS=
AZURE_AD_TENANT_ID=common

# =============================================================================
# GitHub (optional)
# =============================================================================
# Fine-grained token with read access to agent repos (Contents: read).
# Needed for private agent repos (e.g. OpenClaw workspaces) to list skills
# and commits. Public repos work without it, subject to GitHub rate limits.
GITHUB_TOKEN=

# Brain tab: REVERIE_TOKEN (bearer token for each agent's `reverie serve`, see
# knowall-ai/reverie) is set only in App Service settings or an untracked .env.
# BRAIN_FIXTURE=1 serves a built-in graph for development instead.

# =============================================================================
# LLM provider billing (optional)
# =============================================================================
# Azure costs come from Cost Management using the signed-in user's token.
# API spend at OpenAI / Anthropic needs an organisation *admin* key; map an
# agent to its OpenAI project (openaiProjectId) or Anthropic workspace
# (anthropicWorkspaceId) in config/agents.json. Leave blank to skip.
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=

# =============================================================================
# Application Settings
# =============================================================================
APP_URL=http://localhost:3103
# Comma-separated list of Azure tags that identify an agent (first match wins)
AGENT_TAG_KEYS=agent,project
# Cache TTL in seconds for Azure / GitHub / Foundry lookups
CACHE_TTL_SECONDS=60
