# Agents Portal Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# NextAuth Configuration
# =============================================================================
NEXTAUTH_URL=http://localhost:3103
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32

# =============================================================================
# Microsoft Entra ID (Azure AD) Configuration
# =============================================================================
# Multi-tenant app registration ("Agents Portal"). See docs/DEPLOYMENT.adoc.
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
# Default tenant used to sign in. "common" lets any Entra tenant sign in;
# users can switch tenant from the header once signed in.
# Tenants allowed to sign in (comma-separated). Unset = only AZURE_AD_TENANT_ID, if
# that names a tenant. With AZURE_AD_TENANT_ID=common (or organizations) and this
# unset there is no allow-list, and sign-in is refused for everyone: production
# deployments must set AZURE_AD_ALLOWED_TENANTS.
AZURE_AD_ALLOWED_TENANTS=
AZURE_AD_TENANT_ID=common

# =============================================================================
# GitHub (optional)
# =============================================================================
# Fine-grained token with read access to agent repos (Contents: read).
# Needed for private agent repos (e.g. OpenClaw workspaces) to list skills
# and commits. Public repos work without it, subject to GitHub rate limits.
GITHUB_TOKEN=

# Portal.Admin / Portal.Viewer app roles (see docs/CUSTOMER-ACCESS.adoc). Leave
# this unset: production then fails closed (a token without a roles claim is a
# viewer) and development stays open. Uncomment with 0 only for a deployment
# that has no app roles yet, and with 1 to enforce roles in development.
# PORTAL_REQUIRE_ROLES=0

# Training tab: repo the training harness publishes runs and curriculum.yaml to
# (knowall-ai/agent-training). Read with GITHUB_TOKEN above; leave unset for the default.
# TRAINING_REPO=knowall-ai/agent-training

# Brain tab: REVERIE_TOKEN (shared bearer token for agents' `reverie serve`; a per-agent
# REVERIE_TOKEN_<AGENT> such as REVERIE_TOKEN_POPPIE wins over it), see
# knowall-ai/reverie) is set only in App Service settings or an untracked .env.
# BRAIN_FIXTURE=1 serves a built-in graph for development instead.

# Recordings tab (admin-only): RECORDINGS_TOKEN (shared bearer token for agents' Presence
# bridge recordings API; a per-agent RECORDINGS_TOKEN_<AGENT> such as RECORDINGS_TOKEN_SALLIE
# wins over it) is set only in App Service settings or an untracked .env.
# RECORDINGS_FIXTURE=1 serves built-in sample recordings for development instead.

# =============================================================================
# LLM provider billing (optional)
# =============================================================================
# Azure costs come from Cost Management using the signed-in user's token.
# API spend at OpenAI / Anthropic needs an organisation *admin* key; map an
# agent to its OpenAI project (openaiProjectId) or Anthropic workspace
# (anthropicWorkspaceId) in config/agents.json. Leave blank to skip.
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=

# =============================================================================
# Application Settings
# =============================================================================
APP_URL=http://localhost:3103
# Comma-separated list of Azure tags that identify an agent (first match wins)
AGENT_TAG_KEYS=agent,project
# Cache TTL in seconds for Azure / GitHub / Foundry lookups
CACHE_TTL_SECONDS=60
