{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agents Portal registry",
  "type": "object",
  "required": ["agents"],
  "properties": {
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string" },
          "kind": { "enum": ["openclaw", "foundry", "botframework", "unknown"] },
          "customer": { "type": "string" },
          "description": { "type": "string" },
          "environment": { "enum": ["prod", "test", "dev", "unknown"] },
          "portalUrl": { "type": "string", "format": "uri" },
          "healthUrl": { "type": "string", "format": "uri" },
          "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
          "skillsPath": { "type": "string" },
          "skillSources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["repo", "path"],
              "additionalProperties": false,
              "properties": {
                "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
                "path": { "type": "string" }
              }
            }
          },
          "soulPath": { "type": "string" },
          "brainUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "boost": {
            "type": "object",
            "required": ["script"],
            "additionalProperties": false,
            "properties": {
              "script": { "type": "string" },
              "defaultHours": { "type": "number", "minimum": 0.25 },
              "maxHours": { "type": "number", "minimum": 0.25 }
            }
          },
          "appRegistrations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["appId"],
              "additionalProperties": false,
              "properties": {
                "appId": { "type": "string", "format": "uuid" },
                "label": { "type": "string" }
              }
            }
          },
          "resourceGroups": { "type": "array", "items": { "type": "string" } },
          "subscriptionIds": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" },
            "description": "Subscriptions the resourceGroups live in. Required when the portal trusts more than one tenant, since resource-group names are only unique inside a subscription"
          },
          "planned": { "type": "boolean" },
          "avatarUrl": { "type": "string" },
          "teamsUpn": {
            "type": "string",
            "format": "email",
            "description": "Override only; prefer the agent-teams-upn tag in Azure so no address lives in this public repo"
          },
          "openaiProjectId": { "type": "string", "pattern": "^proj_" },
          "anthropicWorkspaceId": { "type": "string", "pattern": "^wrkspc_" },
          "fixedCosts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "amount", "currency"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string" },
                "amount": { "type": "number", "minimum": 0 },
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
              }
            }
          }
        }
      }
    }
  }
}
